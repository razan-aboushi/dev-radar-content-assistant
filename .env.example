# ---------------------------------------------------------------------------
# dev-radar configuration. Copy to .env and edit. Every value has a default,
# so an empty .env still runs.
# ---------------------------------------------------------------------------

# AI provider: none | ollama | openai-compatible
# "none" is fully supported: research, scoring and structured drafts all work.
AI_PROVIDER=ollama

# --- Ollama (free, local) ---------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# --- OpenAI-compatible (optional) -------------------------------------------
# Works with any server exposing /v1/chat/completions, including llama.cpp's
# server, LM Studio, vLLM and text-generation-webui. All of those are free.
# Leave OPENAI_API_KEY empty for local servers that do not check it.
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_MODEL=local-model
OPENAI_API_KEY=

# --- Storage ----------------------------------------------------------------
DATABASE_PATH=./data/radar.db
EXPORT_DIR=./out

# --- Dashboard --------------------------------------------------------------
PORT=4311
HOST=127.0.0.1

# --- Networking -------------------------------------------------------------
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=2
HTTP_CONCURRENCY=4
# Politeness delay between requests to the same host, milliseconds.
HTTP_HOST_DELAY_MS=1000
USER_AGENT=dev-radar/1.0 (personal research tool)

# --- Optional GitHub token --------------------------------------------------
# Not required. Unauthenticated GitHub API allows 60 requests/hour, which is
# enough for the default source list. A free personal token raises it to 5000.
GITHUB_TOKEN=
